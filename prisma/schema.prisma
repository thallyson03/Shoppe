// =============================================================================
// Prisma Schema — Fase 1 (plataforma afiliados Shopee)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Catálogo
// -----------------------------------------------------------------------------

model Shop {
  id        String   @id @default(cuid())
  shopId    String   @unique @map("shop_id")
  name      String
  imageUrl  String?  @map("image_url")
  rating    Decimal? @db.Decimal(3, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products Product[]

  @@map("shops")
}

model Product {
  id                   String    @id @default(cuid())
  itemId               String    @unique @map("item_id")
  shopId               String?   @map("shop_db_id")
  externalShopId       String?   @map("external_shop_id")
  name                 String
  imageUrl             String?   @map("image_url")
  productLink          String?   @map("product_link")
  offerLink            String    @map("offer_link")
  priceMin             Decimal?  @map("price_min") @db.Decimal(12, 2)
  priceMax             Decimal?  @map("price_max") @db.Decimal(12, 2)
  priceDiscountRate    Int?      @map("price_discount_rate")
  sales                Int?      @default(0)
  ratingStar           Decimal?  @map("rating_star") @db.Decimal(3, 2)
  commissionRate       Decimal?  @map("commission_rate") @db.Decimal(8, 4)
  sellerCommissionRate Decimal?  @map("seller_commission_rate") @db.Decimal(8, 4)
  shopeeCommissionRate Decimal?  @map("shopee_commission_rate") @db.Decimal(8, 4)
  category             String?
  lastSyncedAt         DateTime? @map("last_synced_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  shop        Shop?         @relation(fields: [shopId], references: [id], onDelete: SetNull)
  offers      Offer[]
  pricePoints PriceHistory[]
  scheduledPosts ScheduledPost[]

  @@index([commissionRate])
  @@index([sales])
  @@index([ratingStar])
  @@index([priceDiscountRate])
  @@index([createdAt])
  @@map("products")
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String   @map("product_id")
  priceMin  Decimal  @map("price_min") @db.Decimal(12, 2)
  priceMax  Decimal? @map("price_max") @db.Decimal(12, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, recordedAt])
  @@map("price_history")
}

// -----------------------------------------------------------------------------
// Canais e grupos WhatsApp
// -----------------------------------------------------------------------------

model Channel {
  id          String   @id @default(cuid())
  name        String
  type        String   // whatsapp | telegram | instagram | facebook
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  groups    WhatsAppGroup[]
  campaigns Campaign[]

  @@unique([name, type])
  @@map("channels")
}

model WhatsAppGroup {
  id          String   @id @default(cuid())
  name        String
  groupJid    String   @unique @map("group_jid")
  categories  String[] @default([])
  isActive    Boolean  @default(true) @map("is_active")
  channelId   String?  @map("channel_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channel     Channel?     @relation(fields: [channelId], references: [id], onDelete: SetNull)
  publishLogs PublishLog[]
  campaigns   Campaign[]
  scheduledPosts ScheduledPost[]
  automationRules AutomationRule[]

  @@index([isActive])
  @@map("whatsapp_groups")
}

// -----------------------------------------------------------------------------
// Campanhas (esqueleto Fase 1)
// -----------------------------------------------------------------------------

model Campaign {
  id             String    @id @default(cuid())
  name           String
  channelId      String?   @map("channel_id")
  groupId        String?   @map("group_id")
  startsAt       DateTime  @map("starts_at")
  endsAt         DateTime  @map("ends_at")
  commissionGoal Decimal?  @map("commission_goal") @db.Decimal(12, 2)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  channel Channel?      @relation(fields: [channelId], references: [id], onDelete: SetNull)
  group   WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([isActive, startsAt, endsAt])
  @@map("campaigns")
}

// -----------------------------------------------------------------------------
// Fase 2 — Automações e calendário
// -----------------------------------------------------------------------------

/// Regra SE/ENTÃO sem código (ex: desconto > 50% E rating > 4.8 → enviar WhatsApp)
model AutomationRule {
  id          String   @id @default(cuid())
  name        String
  isActive    Boolean  @default(true) @map("is_active")
  /// and | or
  logic       String   @default("and")
  /// [{ field, op, value }] field: discount|rating|commission|sales|price
  /// op: gt|gte|lt|lte|eq
  conditions  Json
  /// send_whatsapp | skip | boost
  action      String   @default("send_whatsapp")
  groupId     String?  @map("group_id")
  priority    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  group WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([isActive, priority])
  @@map("automation_rules")
}

/// Post agendado no calendário
model ScheduledPost {
  id           String    @id @default(cuid())
  title        String
  productId    String?   @map("product_id")
  groupId      String?   @map("group_id")
  messageText  String?   @map("message_text") @db.Text
  imageUrl     String?   @map("image_url")
  offerLink    String?   @map("offer_link")
  scheduledAt  DateTime  @map("scheduled_at")
  /// pending | sent | failed | cancelled
  status       String    @default("pending")
  errorMessage String?   @map("error_message") @db.Text
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  product Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  group   WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([status, scheduledAt])
  @@map("scheduled_posts")
}

// -----------------------------------------------------------------------------
// Ofertas / fila de publicação (legado + Fase 1)
// -----------------------------------------------------------------------------

model Offer {
  id                   String    @id @default(cuid())
  itemId               String    @unique @map("item_id")
  productId            String?   @map("product_id")
  shopId               String?   @map("shop_id")
  productName          String    @map("product_name")
  productLink          String?   @map("product_link")
  offerLink            String    @map("offer_link")
  imageUrl             String?   @map("image_url")
  priceMin             Decimal?  @map("price_min") @db.Decimal(12, 2)
  priceMax             Decimal?  @map("price_max") @db.Decimal(12, 2)
  priceDiscountRate    Int?      @map("price_discount_rate")
  sales                Int?
  ratingStar           Decimal?  @map("rating_star") @db.Decimal(3, 2)
  commissionRate       Decimal?  @map("commission_rate") @db.Decimal(8, 4)
  sellerCommissionRate Decimal?  @map("seller_commission_rate") @db.Decimal(8, 4)
  shopeeCommissionRate Decimal?  @map("shopee_commission_rate") @db.Decimal(8, 4)
  shopName             String?   @map("shop_name")
  messageText          String?   @map("message_text") @db.Text
  published            Boolean   @default(false)
  publishedAt          DateTime? @map("published_at")
  contentHash          String?   @map("content_hash")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  product     Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  publishLogs PublishLog[]

  @@index([published, createdAt])
  @@index([createdAt])
  @@index([productId])
  @@map("offers")
}

model PublishLog {
  id             String   @id @default(cuid())
  offerId        String   @map("offer_id")
  groupId        String?  @map("group_id")
  groupJid       String   @map("group_jid")
  evolutionMsgId String?  @map("evolution_msg_id")
  status         String   @default("sent")
  errorMessage   String?  @map("error_message") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  offer Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  group WhatsAppGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([offerId])
  @@index([groupId])
  @@index([createdAt])
  @@map("publish_logs")
}

model JobRun {
  id             String    @id @default(cuid())
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  status         String    @default("running")
  fetchedCount   Int       @default(0) @map("fetched_count")
  filteredCount  Int       @default(0) @map("filtered_count")
  newOffersCount Int       @default(0) @map("new_offers_count")
  publishedCount Int       @default(0) @map("published_count")
  errorMessage   String?   @map("error_message") @db.Text

  @@index([startedAt])
  @@map("job_runs")
}
