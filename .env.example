# =============================================================================
# Ambiente
# =============================================================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# =============================================================================
# PostgreSQL / Prisma
# =============================================================================
DATABASE_URL=postgresql://shopee:shopee@localhost:5432/shopee_offers?schema=public

# =============================================================================
# Shopee Affiliate Open API (GraphQL)
# Obtenha App ID e Secret no painel: https://affiliate.shopee.com.br
# =============================================================================
SHOPEE_APP_ID=seu_app_id
SHOPEE_SECRET=seu_secret
SHOPEE_GRAPHQL_URL=https://open-api.affiliate.shopee.com.br/graphql

# Busca de produtos (keyword, listType, sortType, limit)
SHOPEE_KEYWORD=
SHOPEE_LIST_TYPE=0
SHOPEE_SORT_TYPE=2
SHOPEE_PAGE_LIMIT=20

# =============================================================================
# Filtros de qualidade das ofertas
# =============================================================================
# Comissão mínima (ex: 0.05 = 5%)
FILTER_MIN_COMMISSION_RATE=0.03
# Desconto mínimo em % (ex: 20 = 20% off)
FILTER_MIN_DISCOUNT_RATE=10
# Avaliação mínima (0 a 5)
FILTER_MIN_RATING=4.0
# Vendas mínimas
FILTER_MIN_SALES=50
# Máximo de ofertas salvas na fila por ciclo
FILTER_MAX_SAVE_PER_RUN=10
# Máximo de ofertas ENVIADAS por ciclo do cron (recomendado: 1)
FILTER_MAX_OFFERS_PER_RUN=1

# =============================================================================
# Frequência / anti-spam (manhã · tarde · noite)
# =============================================================================
# Limite diário total
PUBLISH_MAX_PER_DAY=50
# Intervalo mínimo entre envios (ms) — 60000 = 1 produto/minuto
PUBLISH_MIN_INTERVAL_MS=60000
PUBLISH_TIMEZONE=America/Sao_Paulo
# Janelas (horas locais): manhã 7–12, tarde 12–18, noite 18–23
PUBLISH_MORNING_START=7
PUBLISH_AFTERNOON_START=12
PUBLISH_NIGHT_START=18
PUBLISH_NIGHT_END=23
# Cotas base por período (sobras rolam para o próximo)
PUBLISH_MORNING_LIMIT=17
PUBLISH_AFTERNOON_LIMIT=17
PUBLISH_NIGHT_LIMIT=16

# =============================================================================
# Evolution API (WhatsApp)
# =============================================================================
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=sua_api_key
EVOLUTION_INSTANCE=shopee
# JID do grupo WhatsApp (ex: 1203630xxxxxxxxx@g.us)
EVOLUTION_GROUP_JID=1203630xxxxxxxxx@g.us
# Delay extra Evolution (ms) — o intervalo anti-spam já cobre 1/min
EVOLUTION_SEND_DELAY_MS=2000

# =============================================================================
# Cron (verificar API a cada 5 minutos)
# =============================================================================
CRON_SCHEDULE=*/5 * * * *
# Se true, executa um ciclo imediatamente ao subir o servidor
CRON_RUN_ON_START=true

# =============================================================================
# Auth Fase 2 (JWT). Com false, mutações ficam abertas (compatível com deploy).
# =============================================================================
AUTH_ENABLED=true
JWT_SECRET=change-me-shopee-jwt-secret
SEED_ADMIN_EMAIL=admin@shoppe.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrador
